     "ruleId": "caa/CWE-862",
     "level": "error",
     "message": {
      "text": "Missing authorization: GET /admin/export has no authentication while 2 comparable route(s) require it"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "authz/admin.py"
        },
        "region": {
         "startLine": 47,
         "endLine": 49
        }
       }
      }
     ],
     "partialFingerprints": {
      "caaId": "CAA-8df85eaf"
     },
     "properties": {
      "confidence": "L3",
      "status": "open",
      "severity": "high",
      "severityRationale": "impact: A sensitive action can be called without the authentication/role check its sibling endpoints have. | reachable from an HTTP route (evidence L3)",
      "group": "B",
      "notVerified": [
       "L4 skipped: no property check for this class / entry point",
       "no dynamic (L4) confirmation was performed",
       "scope: first-party code only; framework and driver behaviour assumed as documented"
      ],
      "sources": [
       "authz-routes"
      ],
      "evidence": [
       {
        "level": "L0",
        "by": "authz-routes",
        "detail": "pattern match: caa.authz.missing-auth-vs-siblings"
       },
       {
        "level": "L1",
        "by": "route-policy",
        "detail": "two hints: handler lacks the check AND a sibling of the same resource has it"
       },
       {
        "level": "L2",
        "by": "route-map",
        "detail": "no authentication decorator or inline check"
       },
       {
        "level": "L3",
        "by": "defender",
        "detail": "no global hook, no ownership check in handler, callees or decorators"
       }
      ]
     },
     "codeFlows": [
      {
       "threadFlows": [
        {
         "locations": [
          {
           "location": {
