     "ruleId": "caa/CWE-862",
     "level": "error",
     "message": {
      "text": "Missing authorization: GET /admin/export has no authentication while 2 route(s) of the same resource require it"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "authz/admin.py"
        },
        "region": {
         "startLine": 47,
         "endLine": 49
